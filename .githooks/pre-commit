#!/usr/bin/env bash
# Refuse a commit that leaves the suite red.
#
# Twice now a refactor was committed and the failure surfaced afterwards: a renamed element id
# broke the demo (the page rendered, every number stayed blank) and a changed import broke two
# dashboard tests. Neither is visible to the page gate alone, and neither should reach a commit.
#
# Bypass deliberately, never habitually:  git commit --no-verify
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

PY="${PYTHON:-python}"
if ! command -v "$PY" >/dev/null 2>&1; then
    echo "pre-commit: no python on PATH; set PYTHON=/path/to/python.exe" >&2
    exit 1
fi

echo "pre-commit: test suite"
"$PY" -m pytest -q || { echo "pre-commit: tests failed; commit refused" >&2; exit 1; }

echo "pre-commit: fixture audit (every check must trip)"
"$PY" tools/audit_fixtures.py >/dev/null     || { echo "pre-commit: a gate check has no fixture, or one rejects for the wrong reason" >&2; exit 1; }

echo "pre-commit: mutation and chain audits"
"$PY" tools/fuzz_register.py --no-record >/dev/null     || { echo "pre-commit: a wrong register passes the gate" >&2; exit 1; }
"$PY" tools/audit_chain_fixtures.py >/dev/null     || { echo "pre-commit: a chain consumer does not behave as declared" >&2; exit 1; }

echo "pre-commit: state record is current"
"$PY" tools/evolution.py --check >/dev/null     || { echo "pre-commit: docs/EVOLUTION.json is stale; run tools/evolution.py" >&2; exit 1; }

echo "pre-commit: screenshots match their pages"
"$PY" tools/screens.py --check >/dev/null     || { echo "pre-commit: a page changed after its screenshot was taken; run tools/screens.py --update" >&2; exit 1; }

echo "pre-commit: verifiers still refuse"
"$PY" tools/audit_verifiers.py --fixtures >/dev/null     || { echo "pre-commit: a verifier stopped refusing (stats or citations)" >&2; exit 1; }

echo "pre-commit: page gate (no browser)"
"$PY" tools/audit_site.py --no-build --skip-browser \
    || { echo "pre-commit: page gate failed; commit refused" >&2; exit 1; }

echo "pre-commit: ok"
