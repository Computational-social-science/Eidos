# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv*/
venv/
.env

# Data and outputs (projects keep their own .gitignore)
projects/*/data/
projects/*/outputs/
projects/*/experiments/
projects/*/manuscript/_freeze/
projects/*/manuscript/_extensions/

# Memory / tracking side-stores
memory/chroma/
memory/memory.json
mlruns/
mlruns.db
.dvc/cache/
.dvc/tmp/

# Quarto
_freeze/
_site/
.quarto/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Scratch
*.log
tmp/
.pytest_cache/

# Local test artifacts
.memtest/
.memchroma/
ci_log.txt
lab/*.png
.coverage
coverage.xml

# Runtime state: the watcher rewrites these every 15 s. Tracked once, now ignored — a dirty
# tree should mean "code changed", not "the sampler ticked".
docs/status/current.json
docs/status/timeline.json
docs/status/alarms.json
docs/status/history.jsonl
docs/status/faults.jsonl
docs/status/durations.jsonl
docs/status/recoveries.jsonl
docs/status/recovery_state.json
docs/status/chains.json
docs/status/scheduler.json
docs/status/scheduler.log
docs/status/serve.log
reference/*/docs/results_files/
reference/*/docs/*_files/

# throwaway environments created by tools/update_operator.py try (the JSON verdicts stay)
docs/status/update_tries/*/
_shots/
docs/status/*.jsonl
scripts/monitor.env

# verifier outputs (regenerated, with fixtures committed instead)
artifacts/
# Fixture artefacts are part of the test inputs, not runtime output: the clean control cites a
# reproduction record, and a clone without it fails S12. Everything else under artifacts/ stays out.
!reference/fixtures/*/artifacts/
!reference/fixtures/*/artifacts/**

# Paper2Agent working trees and third-party PDFs stay out of the repository.
reference/reproduction/*/p2a_work/
reference/reproduction/*/paper/
reference/reproduction/*/dist/
