98fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\r\n+      \"size\": 0\r\n+    },\r\n+    \"output/red-container.stdout\": {\r\n+      \"sha256\": \"db48927c59013311c62c55c5e5e84747fdabb759b1a7c89414cf8c10bc86a957\",\r\n+      \"size\": 2819\r\n+    },\r\n+    \"output/red-controller.json\": {\r\n+      \"sha256\": \"b58d0bfed0c7fe8f5efca015850950d9cd133a0512cc5e8fa0c0176bc685d760\",\r\n+      \"size\": 8232\r\n+    },\r\n+    \"output/red-exit.txt\": {\r\n+      \"sha256\": \"4355a46b19d348dc2f57c046f8ef63d4538ebb936000f3c9ee954a27460dd865\",\r\n+      \"size\": 2\r\n+    },\r\n+    \"output/red-worker.json\": {\r\n+      \"sha256\": \"a1907fa43b37980cd93307e720607c8bc2a5cbd7b4f1458b596b1d93c47cf362\",\r\n+      \"size\": 118\r\n+    },\r\n+    \"output/red.stderr\": {\r\n+      \"sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\r\n+      \"size\": 0\r\n+    },\r\n+    \"output/red.stdout\": {\r\n+      \"sha256\": \"ade5738801c774f1f07fb138c20ac146ff84292ec5ac0a3b5f16bfded1184ed9\",\r\n+      \"size\": 2393\r\n+    },\r\n+    \"output/red.xml\": {\r\n+      \"sha256\": \"799b3f993490d085f32fbef1af0d2f855e576feb466c1f61e65c9f31df4de9c2\",\r\n+      \"size\": 2098\r\n+    },\r\n+    \"input/green/test_installed_cli.py\": {\r\n+      \"sha256\": \"4c85f915f96551b528012a43ac5247f2a643d89ced60e727a50f1b92d7bb6c81\",\r\n+      \"size\": 16036\r\n+    },\r\n+    \"input/green/test_monitor_registry.py\": {\r\n+      \"sha256\": \"3165c41e943a4741550a058b6f358fc18ee5b467e0b6f8cd64e624e4548b5790\",\r\n+      \"size\": 3468\r\n+    },\r\n+    \"input/red/test_installed_cli.py\": {\r\n+      \"sha256\": \"4c85f915f96551b528012a43ac5247f2a643d89ced60e727a50f1b92d7bb6c81\",\r\n+      \"size\": 16036\r\n+    },\r\n+    \"input/red/test_monitor_registry.py\": {\r\n+      \"sha256\": \"70b546158dc8a92f2f3020a56fb172d2fd26d5705d08376f938f542169f927bc\",\r\n+      \"size\": 3218\r\n+    }\r\n+  }\r\n+}\r","raw_url":"https://github.com/Comput