\": \"completed\",\r\n+          \"conclusion\": \"success\",\r\n+          \"number\": 1,\r\n+          \"started_at\": \"2026-11-04T03:47:33Z\",\r\n+          \"completed_at\": \"2026-11-04T03:47:34Z\"\r\n+        },\r\n+        {\r\n+          \"name\": \"Run actions/checkout@v4\",\r\n+          \"status\": \"completed\",\r\n+          \"conclusion\": \"success\",\r\n+          \"number\": 2,\r\n+          \"started_at\": \"2026-11-04T03:47:34Z\",\r\n+          \"completed_at\": \"2026-11-04T03:47:38Z\"\r\n+        },\r\n+        {\r\n+          \"name\": \"Run actions/setup-python@v5\",\r\n+          \"status\": \"completed\",\r\n+          \"conclusion\": \"success\",\r\n+          \"number\": 3,\r\n+          \"started_at\": \"2026-11-04T03:47:38Z\",\r\n+          \"completed_at\": \"2026-11-04T03:47:38Z\"\r\n+        },\r\n+        {\r\n+          \"name\": \"Source, documentation and release history agree\",\r\n+          \"status\": \"completed\",\r\n+          \"conclusion\": \"success\",\r\n+          \"number\": 4,\r\n+          \"started_at\": \"2026-11-04T03:47:38Z\",\r\n+          \"completed_at\": \"2026-11-04T03:47:39Z\"\r\n+        },\r\n+        {\r\n+          \"name\": \"Publication artifacts match their inspected fingerprints\",\r\n+          \"status\": \"completed\",\r\n+          \"conclusion\": \"success\",\r\n+          \"number\": 5,\r\n+          \"started_at\": \"2026-11-04T03:47:39Z\",\r\n+          \"completed_at\": \"2026-11-04T03:47:39Z\"\r\n+        },\r\n+        {\r\n+          \"name\": \"Post Run actions/setup-python@v5\",\r\n+          \"status\": \"completed\",\r\n+          \"conclusion\": \"success\",\r\n+          \"number\": 9,\r\n+          \"started_at\": \"2026-11-04T03:47:39Z\",\r\n+          \"completed_at\": \"2026-11-04T03:47:39Z\"\r\n+        },\r\n+        {\r\n+          \"name\": \"Post Run actions/checkout@v4\",\r\n+          \"status\": \"completed\",\r\n+          \"conclusion\": \"success\",\r\n+          \"number\": 10,\r\n+          \"started_at\": \"2026-11-04T03:47:39Z\",\r\n+          \"completed_at\": \"2026-11-04T03:47:40Z\"\r\n+        },\r\n+        {\r\n+          \"name\": \"Complete job\",\r\n+          \"status\": \"completed\",\r\n+          \"conclusion\": \"success\",\r\n+          \"number\": 11,\r\n+          \"started_at\": \"2026-11-04T03:47:40Z\",\r\n+          \"completed_at\": \"2026-11-04T03:47:40Z\"\r\n+        }\r\n+      ],\r\n+      \"check_run_url\": \"https://api.github.com/repos/Computational-social-science/Eidos/check-runs/126374874667\",\r\n+      \"labels\": [\r\n+        \"ubuntu-latest\"\r\n+      ],\r\n+      \"runner_id\": 1000003734,\r\n+      \"runner_name\": \"GitHub Actions 1000003734\",\r\n+      \"runner_group_id\": 0,\r\n+      \"runner_group_name\": \"GitHub Actions\"\r\n+    },\r\n+    {\r\n+      \"id\": 126376674336,\r\n+      \"run_id\": 41769268859,\r\n+      \"workflow_name\": \"ci\",\r\n+      \"head_branch\": \"main\",\r\n+      \"run_url\": \"https://api.github.com/repos/Computational-social-science/Eidos/actions/runs/41769268859\",\r\n+      \"run_attempt\": 1,\r\n+      \"node_id\": \"CR_kwDOVR8FZ88AAAAdbKMEIA\",\r\n+      \"head_sha\": \"21e26b784604616a96648a615f48aa2747f35e7f\",\r\n+      \"url\": \"https://api.github.com/repos/Computational-social-science/Eidos/actions/jobs/126376674336\",\r\n+      \"html_url\": \"https://github.com/Computational-social-science/Eidos/actions/runs/41769268859/job/126376674336\",\r\n+      \"status\": \"completed\",\r\n+      \"conclusion\": \"skipped\",\r\n+      \"created_at\": \"2026-11-04T03:53:14Z\",\r\n+      \"started_at\": \"2026-11-04T03:53:14Z\",\r\n+      \"completed_at\": \"2026-11-04T03:53:14Z\",\r\n+      \"name\": \"browser\",\r\n+      \"steps\": [],\r\n+      \"check_run_url\": \"https://api.github.com/repos/Computational-social-science/Eidos/check-runs/126376674336\",\r\n+      \"labels\": [\r\n+        \"ubuntu-latest\"\r\n+      ],\r\n+      \"runner_id\": null,\r\n+      \"runner_name\": null,\r\n+      \"runner_group_id\": null,\r\n+      \"runner_group_name\": null\r\n+    },\r\n+    {\r\n+      \"id\": 126376674708,\r\n+      \"run_id\": 41769268859,\r\n+      \"workflow_name\": \"ci\",\r\n+      \"head_branch\": \"main\",\r\n+      \"run_url\": \"https://api.github.com/repos/Computational-social-science/Eidos/actions/runs/41769268859\",\r\n+      \"run_attempt\": 1,\r\n+      \"node_id\": \"CR_kwDOVR8FZ88AAAAdbKMFlA\",\r\n+      \"head_sha\": \"21e26b784604616a96648a615f48aa2747f35e7f\",\r\n+      \"url\": \"https://api.github.com/repos/Computational-social-science/Eidos/actions/jobs/126376674708\",\r\n+      \"html_url\": \"https://github.com/Computational-social-science/Eidos/actions/runs/41769268859/job/126376674708\",\r\n+      \"status\": \"completed\",\r\n+      \"conclusion\": \"skipped\",\r\n+      \"created_at\": \"2026-11-04T03:53:14Z\",\r\n+      \"started_at\": \"2026-11-04T03:53:14Z\",\r\n+      \"completed_at\": \"2026-11-04T03:53:14Z\",\r\n+      \"name\": \"audit\",\r\n+      \"steps\": [],\r\n+      \"check_run_url\": \"https://api.github.com/repos/Computational-social-science/Eidos/check-runs/126376674708\",\r\n+      \"labels\": [\r\n+        \"ubuntu-latest\"\r\n+      ],\r\n+      \"runner_id\": null,\r\n+      \"runner_name\": null,\r\n+      \"runner_group_id\": null,\r\n+      \"runner_group_name\": null\r\n+    }\r\n+  ]\r\n+}\n\\ No newline at end of file","raw_url":"https://github.com/Computational-social-science/Eidos/raw/045c9e08b1f0aceff2e63a23ab77e121c141c6ae/reference%2Fshared_monitor_acceptance%2Frecorded_trials%2Fvenv-entry-ci-v1%2Frelease-v050-ci-failed-jobs.json","sha":"92e0d4d981623da15f55b8e97e1ce65324a326ad","status":"added"},{"additions":25,"blob_url":"https://github.com/Computational-social-science/Eidos/blob/045c9e08b1f0aceff2e63a23ab77e121c141c6ae/site%2FQuarto_Centric_Local_Research_Pipeline_Technical_Framework.md","changes":25,"contents_url":"https://api.github.com/repos/Computational-social-science/Eidos/contents/site%2FQuarto_Centric_Local_Research_Pipeline_Technical_Framework.md?ref=045c9e08b1f0aceff2e63a23ab77e121c141c6ae","deletions":0,"filename":"site/Quarto_Centric_Local_Research_Pipeline_Technical_Framework.md","patch":"@@ -691,3 +691,28 @@ preserved; a fresh real chain audit and subsequent heartbeat returned the\n monitor to OK. This does not deploy the unreleased worker/controller protocol.\n The local front door now displays EIDOS Agent while retaining the published\n 0.4.12 version label. See [the incident record](docs/RUNTIME-INCIDENT-INFERENCE-2026-11-03.md).\n+\n+## Real-origin release-candidate checkpoint (2026-11-04)\n+\n+The deterministic producer now executes the protected inherited-pipe oracle and\n+the original `audit_inference` owner. The actual Eidos project incident\n+`0c2c202832764e7f959864f4638da0da` reaches VALIDATED with eight linked events.\n+The old artifact fails, a deliberately unchanged-SDK candidate is rejected, and\n+physical baseline restoration preserves nonempty actual run history. The repaired\n+candidate passes; premature closure is refused. Interrupted trial selection and\n+unobserved post-adoption checks restore the prior selection without overwriting\n+an unrelated pin. Ten producer refusal/recovery controls pass separately.\n+\n+The exact 51-module wheel, SHA256\n+`56d2fe35b1e5ab552fe001ae675e3af4f095e78522fa8fae682f5ea41cfa301c`,\n+passes normal installed numerical, lifecycle and recovery-shell qualification on\n+Windows and a same-host offline Linux container. Linux also checks both console\n+aliases and the old/repaired probe. Frozen profiles and the release-candidate\n+record retain raw identities and outcomes. These observations do not qualify a\n+new machine, GPU, installed resident controller or scientific RSI.\n+\n+Publication, exact-delivery-commit CI, originating-project adoption, failed-replay\n+reversion and fresh successful replay remain pending at this checkpoint. The\n+producer will fetch the actual public tag, CI and asset bytes before recording a\n+release. Software closure must retain scientific_status UNRUN. The existing\n+8765 resident monitor remains on its separately documented 0.4.12 runtime.","raw_url":"https://github.com/Computational-social-science/Eidos/raw/045c9e08b1f0aceff2e63a23ab77e121c141c6ae/site%2FQuarto_Centric_Local_Research_Pipeline_Technical_Framework.md","sha":"8d6be447ed5cef3048dcb621525083d71f061798","status":"modified"},{"additions":10,"blob_url":"https://github.com/Computational-social-science/Eidos/blob/045c9e08b1f0aceff2e63a23ab77e121c141c6ae/site%2FREADME.md","changes":19,"contents_url":"https://api.github.com/repos/Computational-social-science/Eidos/contents/site%2FREADME.md?ref=045c9e08b1f0aceff2e63a23ab77e121c141c6ae","deletions":9,"filename":"site/README.md","patch":"@@ -1,10 +1,11 @@\n # EIDOS Agent \u2014 reusable research execution and evidence\n \n-**Version 0.5.0** \u00b7 unreleased development candidate \u00b7 local-first \u00b7 MIT framework\n+**Version 0.5.0** \u00b7 compatibility preview \u00b7 local-first \u00b7 MIT framework\n \n-Latest published release: [0.4.12](https://github.com/Computational-social-science/Eidos/releases/tag/v0.4.12).\n-The version above identifies development source, not a published 0.5.0 product.\n-Release-integrity checking still blocks the source/history mismatch.\n+Publication state and exact assets: [0.5.0 release record](https://github.com/Computational-social-science/Eidos/releases/tag/v0.5.0).\n+The delivery record binds source, exact-head CI, tag and qualified wheel bytes;\n+preparation alone does not establish publication. The existing local resident\n+monitor has its separate 0.4.12 runtime and is not upgraded by installing a worker.\n [Main-branch CI](https://github.com/Computational-social-science/Eidos/actions/workflows/ci.yml)\n is separate from candidate acceptance.\n \n@@ -22,16 +23,16 @@ should require a pinned core package and small project-local configuration.\n \n | Entry point | Availability and boundary |\n |---|---|\n-| SDK / release wheel | Published 0.4.12; explicit project registration, execution, verification and delivery |\n-| Installed project CLI | Unreleased candidate: init/check/status/report/feedback with retained installed trials |\n+| SDK / release wheel | Qualified 0.5.0 compatibility artifact; verify the actual release record before installation |\n+| Installed project CLI | init/check/status/report/feedback with retained Windows/Linux installed trials |\n | Shared worker observation | Candidate protocol, bounded source collector and UI tested; existing 8765 process not migrated |\n | Thin project Agent skill | Instruction adapter and CLI tool smoke; live Agent reasoning needs separate acceptance |\n | Public PyPI / generic MCP | Not delivered; naming, compatibility and adapter qualification remain open |\n-| Complete feedback / scientific RSI | Not established; originating-project release replay and held-out improvement remain open |\n+| Software feedback / scientific RSI | Protected real-origin preparation is VALIDATED; publication/adoption/replay remain pending until actual receipts. Scientific RSI needs separate held-out acceptance |\n \n Start with [project integration](docs/PROJECT_INTEGRATION.md), the English\n-[installed-candidate quickstart](https://github.com/Computational-social-science/Eidos/blob/feature/shared-monitor/docs/DOWNSTREAM-QUICKSTART.md)\n-and [delivery plan](https://github.com/Computational-social-science/Eidos/blob/feature/shared-monitor/docs/REUSE-DELIVERY-PLAN.md).\n+[installed-worker quickstart](docs/DOWNSTREAM-QUICKSTART.md)\n+and [delivery plan](docs/REUSE-DELIVERY-PLAN.md).\n Do not run `pip install eidos` from PyPI for this framework: that name belongs to\n an unrelated astronomy package. Exact wheel/hash installation is a separate path.\n ","raw_url":"https://github.com/Computational-social-science/Eidos/raw/045c9e08b1f0aceff2e63a23ab77e121c141c6ae/site%2FREADME.md","sha":"04bca415e16497eec674c58c325fe697ae3a73ee","status":"modified"},{"additions":4,"blob_url":"https://github.com/Computational-social-science/Eidos/blob/045c9e08b1f0aceff2e63a23ab77e121c141c6ae/site%2Fdashboard.html","changes":8,"contents_url":"https://api.github.com/repos/Computational-social-science/Eidos/contents/site%2Fdashboard.html?ref=045c9e08b1f0aceff2e63a23ab77e121c141c6ae","deletions":4,"filename":"site/dashboard.html","patch":"@@ -168,7 +168,7 @@ <h1>Research operations, with the evidence in view.</h1>\n   <section class=\"card\">\r\n     <h2>Framework self-audit \u2014 chains \u00d7 modules \u00d7 service boundaries</h2>\r\n     <div class=\"key\"><span><i style='background:#57ab5a'></i>PASS</span><span><i style='background:#7d8590'></i>SKIP</span><span><i style='background:#5b8def'></i>RUNNING</span><span><i style='background:#d29922'></i>STALE</span><span><i style='background:#e5534b'></i>FAIL</span><span><i style='background:#2a2f36'></i>IDLE</span></div>\r\n-    <div class=\"matrix-scroll\" tabindex=\"0\" role=\"region\" aria-label=\"Scrollable dependency matrix\"><svg class='assembly-matrix' viewBox='0 0 1264 532' width='100%' role='img' aria-label='coupling matrix of chains, modules and services'><defs><marker id='ah' viewBox='0 0 10 10' refX='8.5' refY='5' markerWidth='4.6' markerHeight='4.6' orient='auto'><path d='M0 1 L9 5 L0 9 z' fill='context-stroke'/></marker></defs><rect x='0' y='0' width='1264' height='46' fill='#12151a'/><text x='312' y='12' font-size='10' letter-spacing='0.12em' fill='#7d8899' font-family='ui-monospace,Consolas,monospace'>MODULES</text><text x='924' y='12' font-size='10' letter-spacing='0.12em' fill='#7d8899' font-family='ui-monospace,Consolas,monospace'>SERVICES</text><line x1='0' y1='46' x2='1264' y2='46' stroke='rgba(255,255,255,0.14)'/><g transform='translate(34,0)'><g class='node module' data-module='framework.gates' data-users='gates,gates+project checker,diagnosis' tabindex='0' role='button'><title>