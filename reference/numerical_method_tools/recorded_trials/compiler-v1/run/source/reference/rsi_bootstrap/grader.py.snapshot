"""Calibrate a public log1mexp development oracle; never promotes a model.

Run with the EIDOS project interpreter. The closed set of implementations below
are evaluator controls, not candidates generated by EIDOS. Arbitrary candidate
code execution and sealed evaluation are intentionally separate work packages.
"""

from __future__ import annotations

import argparse
from dataclasses import dataclass
from datetime import datetime, timezone
from decimal import Decimal, localcontext
import hashlib
import json
import os
from pathlib import Path
import platform
import sys
import tempfile
import time

import numpy as np


ROOT = Path(__file__).resolve().parents[2]
PROTOCOL = ROOT / ".Codex/evals/rsi-bootstrap-foundation.md"
TOLERANCES = {"float32": 2e-5, "float64": 2e-12}


@dataclass(frozen=True)
class Case:
    name: str
    value: np.ndarray


def development_cases() -> list[Case]:
    """Exactly the public domain fixed in the protocol, with represented inputs."""
    cases = []
    for dtype, values, tail in (
        (np.float32, [1e-30, 1e-12, 1e-8, 1e-5, 0.1], [1, 20, 50, 80]),
        (np.float64, [1e-100, 1e-16, 1e-12, 1e-8, 0.1], [1, 20, 50, 80, 600]),
    ):
        label = np.dtype(dtype).name
        for index, value in enumerate(values):
            cases.append(Case(f"{label}-small-{index}", np.asarray(value, dtype=dtype)))
        cutoff = np.log(np.asarray(2, dtype=dtype))
        for side, direction in (("below", -np.inf), ("above", np.inf)):
            value = np.nextafter(cutoff, np.asarray(direction, dtype=dtype))
            cases.append(Case(f"{label}-cutoff-{side}", np.asarray(value)))
        for value in tail:
            cases.append(Case(f"{label}-x-{value}", np.asarray(value, dtype=dtype)))
    return cases


def reference(case: Case, *, precision: int = 420) -> dict[str, Decimal]:
    """Direct high-precision definition at the exact binary input, not a repair."""
    x = case.value
    if (not isinstance(x, np.ndarray) or x.shape != ()
            or x.dtype.name not in TOLERANCES or not np.isfinite(x) or x <= 0):
        raise ValueError("reference requires a positive finite float32/64 scalar array")
    with localcontext() as context:
        context.prec = precision
        exact = Decimal.from_float(float(x))
        exponential = (-exact).exp()
        difference = 1 - exponential
        loss = difference.ln()
        gradient = exponential / difference
        if (not loss.is_finite() or not gradient.is_finite()
                or loss >= 0 or gradient <= 0):
            raise ArithmeticError("reference precision/domain cannot resolve nonzero outputs")
        return {"loss": loss, "gradient": gradient}


def textbook(x: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
    exponential = np.exp(-x)
    return np.log(1 - exponential), exponential / (1 - exponential)


def repair(x: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
    """Externally authored positive control; first derivative only, NumPy backend."""
    cutoff = np.log(np.asarray(2, dtype=x.dtype))
    loss = np.log(-np.expm1(-x)) if x <= cutoff else np.log1p(-np.exp(-x))
    gradient = np.exp(-x) / (-np.expm1(-x))
    return np.asarray(loss), np.asarray(gradient)


def _control(name: str, x: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
    if name == "textbook":
        return textbook(x)
    loss, gradient = repair(x)
    if name == "loss_only":
        return loss, textbook(x)[1]
    if name == "gradient_floor":
        return loss, np.where(abs(gradient) < 1e-20, np.zeros_like(x), gradient)
    if name == "log1p_only":
        return np.log1p(-np.exp(-x)), gradient
    if name == "expm1_only":
        return np.log(-np.expm1(-x)), gradient
    if name == "sign_flip":
        return loss, -gradient
    if name == "always_zero":
        return np.zeros_like(x), np.zeros_like(x)
    if name == "wrong_dtype":
        dtype = np.float64 if x.dtype == np.dtype("float32") else np.float32
        return loss.astype(dtype), gradient.astype(dtype)
    if name != "repair":
        raise ValueError(f"unknown development control: {name}")
    return loss, gradient


def grade(case: Case, loss: np.ndarray, gradient: np.ndarray) -> dict:
    """Evaluate actual returned values with no absolute-error escape hatch."""
    expected = reference(case)
    result = {"case": case.name, "dtype": case.value.dtype.name,
              "represented_input": float(case.value), "passed": False,
              "loss_relative_error": None, "gradient_relative_error": None}
    errors = {}
    for name, output in (("loss", loss), ("gradient", gradient)):
        if not isinstance(output, (np.ndarray, np.floating)):
            result["reason"] = f"{name}: expected a typed NumPy result"
            return result
        value = np.asarray(output)
        if value.shape != case.value.shape or value.dtype != case.value.dtype:
            result["reason"] = f"{name}: shape/dtype mismatch"
            return result
        if not np.isfinite(value).all():
            result["reason"] = f"{name}: nonfinite"
            return result
        with localcontext() as context:
            context.prec = 120
            error = abs(Decimal.from_float(float(value)) / expected[name] - 1)
        errors[name] = error
        result[f"{name}_relative_error"] = float(error)
    tolerance = Decimal(str(TOLERANCES[case.value.dtype.name]))
    result["passed"] = all(error <= tolerance for error in errors.values())
    result["reason"] = "within relative tolerance" if result["passed"] else "relative error"
    return result


def _hash(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def _input_paths() -> list[Path]:
    return [PROTOCOL, Path(__file__).resolve(), Path(__file__).with_name("test_grader.py")]


def _runtime_identity() -> dict:
    return {"python": sys.executable, "version": platform.python_version(),
            "numpy": np.__version__, "numpy_module": np.__file__, "device": "CPU"}


def calibrate() -> dict:
    started = time.monotonic()
    files = _input_paths()
    before = {path: _hash(path) for path in files}
    runtime = _runtime_identity()
    cases = development_cases()
    # Reference convergence is checked before any control can earn acceptance.
    for case in cases:
        low, high = reference(case), reference(case, precision=520)
        for name in ("loss", "gradient"):
            a = np.asarray(float(low[name]), dtype=case.value.dtype)
            b = np.asarray(float(high[name]), dtype=case.value.dtype)
            if a.tobytes() != b.tobytes() or not np.isfinite(a) or a == 0:
                raise ArithmeticError(f"unresolved reference: {case.name}/{name}")
    controls = {}
    for name in ("repair", "textbook", "loss_only", "gradient_floor", "log1p_only",
                 "expm1_only", "sign_flip", "always_zero", "wrong_dtype"):
        with np.errstate(all="ignore"):
            points = [grade(case, *_control(name, case.value.copy())) for case in cases]
        observed = "PASS" if all(point["passed"] for point in points) else "FAIL"
        controls[name] = {"expected": "PASS" if name == "repair" else "FAIL",
                          "observed": observed, "points": points}
    ordinary = []
    with np.errstate(all="ignore"):
        for dtype in (np.float32, np.float64):
            case = Case(f"{np.dtype(dtype).name}-ordinary-clean", np.asarray(1, dtype=dtype))
            ordinary.append(grade(case, *textbook(case.value)))
    after = {path: _hash(path) for path in files}
    if before != after:
        raise RuntimeError("calibration inputs changed during execution")
    if runtime != _runtime_identity():
        raise RuntimeError("calibration runtime identity changed during execution")
    return {
        "schema": "eidos.rsi.development-oracle-calibration.v1",
        "status": "PASS" if all(row["expected"] == row["observed"] for row in controls.values())
        and all(row["passed"] for row in ordinary) else "FAIL",
        "observed_at": datetime.now(timezone.utc).isoformat(),
        "scope": "public development grader calibration, externally authored controls",
        "case_count": len(cases), "control_count": len(controls),
        "reference_precision": [420, 520], "reference_convergence": "PASS",
        "relative_tolerances": TOLERANCES,
        "source_hashes": {path.relative_to(ROOT).as_posix(): digest for path, digest in before.items()},
        "source_stability": "PASS: beginning and ending hashes agree",
        "runtime": {**runtime, "seed": None,
                    "seed_reason": "deterministic enumerated controls; no RNG or model call"},
        "controls": controls, "ordinary_clean_controls": ordinary,
        "model_evaluation": "NOT_RUN", "sealed_evaluation": "NOT_RUN",
        "scientific_rsi": "NOT_DEMONSTRATED", "novelty": "KNOWN_METHOD",
        "wall_seconds": time.monotonic() - started,
    }


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path, help="atomic development receipt destination")
    args = parser.parse_args(argv)
    destination = None
    if args.output is not None:
        destination = args.output.resolve()
        for path in _input_paths():
            if destination == path.resolve() or (destination.exists() and destination.samefile(path)):
                parser.error("receipt output overlaps a bound calibration input")
    report = calibrate()
    body = json.dumps(report, indent=2, allow_nan=False) + "\n"
    if args.output is None:
        print(body, end="")
    else:
        destination.parent.mkdir(parents=True, exist_ok=True)
        temporary = None
        try:
            with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", newline="\n",
                                             dir=destination.parent, delete=False) as stream:
                temporary = Path(stream.name)
                stream.write(body)
            os.replace(temporary, destination)
        finally:
            if temporary is not None:
                temporary.unlink(missing_ok=True)
        print(json.dumps({"status": report["status"], "cases": report["case_count"],
                          "controls": report["control_count"], "output": str(destination)}))
    return 0 if report["status"] == "PASS" else 1


if __name__ == "__main__":
    raise SystemExit(main())
