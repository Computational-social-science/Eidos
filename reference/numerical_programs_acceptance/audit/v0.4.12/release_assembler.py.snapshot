"""Assemble only executed candidate evidence, preserving all earlier release records."""
from datetime import datetime, timezone
import hashlib
import io
import json
from pathlib import Path
import sys
import zipfile

root=Path.cwd()
sys.path.insert(0,str(root))
from framework.artifacts import atomic_output
from tools.record_self_audit import input_state
import v410_receipt_guards as guards
import v412_receipt_guards as new_guards

cache=Path('C:/Users/Administrator/.cache/eidos-sdk-v412')
docs=root/'docs'
now=datetime.now(timezone.utc).isoformat()
sha=lambda body:hashlib.sha256(body).hexdigest()
canonical=lambda body:body.decode('utf-8-sig').replace('\r\n','\n').encode()
inputs={}

def require(ok,message):
    if not ok:raise RuntimeError(message)

def raw(path):
    path=Path(path).resolve()
    body=path.read_bytes()
    if path in inputs:require(inputs[path]==body,'An assembly input changed: '+str(path))
    inputs[path]=body
    return body

def read(path):return json.loads(raw(path).decode('utf-8-sig'))

assembly_sources={
    'reference/numerical_programs_acceptance/audit/v0.4.12/release_assembler.py.snapshot':Path(__file__),
    'reference/numerical_programs_acceptance/audit/v0.4.12/numerical_guards.py.snapshot':Path(new_guards.__file__),
    'reference/numerical_programs_acceptance/audit/v0.4.12/legacy_guards.py.snapshot':Path(guards.__file__)}
assembly_hashes={}
for public,private in assembly_sources.items():
    body=raw(private)
    require(raw(root/public)==body,'Published assembler snapshot differs')
    assembly_hashes[public]=sha(body)

wheel=root/'reference/sdk_process_acceptance/eidos-0.4.12-py3-none-any.whl'
wheel_sha=sha(raw(wheel))
with zipfile.ZipFile(io.BytesIO(raw(wheel))) as archive:
    modules={n:sha(canonical(archive.read(n))) for n in archive.namelist()
             if n.startswith('framework/') and n.endswith('.py')}
source={p.relative_to(root).as_posix():sha(canonical(raw(p))) for p in (root/'framework').rglob('*.py')}
require(modules==source and len(modules)==45,'Whole source/wheel inventory differs')
audit=read(docs/'SELF_AUDIT.json')
require(audit['stability']['stable'] is True and audit['tests']['failed']==audit['tests']['errors']==0,
        'Current full audit failed')
require(input_state()==audit['stability']['before']==audit['stability']['after'],'Stale source/environment audit')
require(not any('fastmcp' in reason for reason in audit['skip_reasons']),'Paper2Agent dependency was not restored')
checkpoint=read(docs/'RELEASE-CANDIDATE-0.4.12.json')
require(checkpoint['wheel_sha256']==wheel_sha and checkpoint['source_sha256_canonical_lf']==modules
        and checkpoint['source_audit']['state']==audit['stability']['after'],'Candidate checkpoint differs')
for name,digest in checkpoint['checkpoint_assembly_sources_sha256_raw'].items():
    require(sha(raw(root/name))==digest,'Candidate checkpoint assembler binding differs')
shell_checks={'default discovery without terminal SHELL',
    'relative override executes unicode/space script after cwd change',
    'expanded override executes the same absolute binary',
    'actual missing shell refuses without budget reservation'}
for platform,folder,file,input_folder in [('windows','windows-results','shell.json','input'),
                                        ('linux','linux-core-1','shell.stdout','input-linux')]:
    body=raw(cache/folder/file);value=json.loads(body);identity=value['identity']
    require(checkpoint['results'][platform+'_shell']['sha256_raw']==sha(body),'Shell checkpoint receipt differs')
    require(value['status']=='PASS' and value['platform']=={'windows':'win32','linux':'linux'}[platform]
            and identity['sdk_version']=='0.4.12' and identity['wheel_sha256']==wheel_sha
            and identity['source_sha256_canonical_lf']==modules and identity['module_count']==45
            and identity['all_installed_metadata_requirements_met'] is True,'Shell receipt identity differs')
    require(len(value['controls']['checks'])==4 and set(value['controls']['checks'])==shell_checks
            and value['controls']['fixture_only'] is True
            and value['controls']['real_model_services_touched'] is False,'Shell control inventory differs')
    for member,field,public in [('shell.py','driver_sha256_raw','recovery_shell_acceptance'),
                                ('numerical.py','identity_driver_sha256_raw','numerical_programs_acceptance')]:
        require(sha(raw(cache/input_folder/member))==value[field]
                and canonical(raw(cache/input_folder/member))==canonical(raw(root/'reference'/public/'check.py')),
                'Shell driver/helper binding differs')
pending={}

def put(name,data):pending[name]=(json.dumps(data,indent=2)+'\n').encode()

def execution(name):
    folder=cache/name
    value=read(folder/'execution.json')
    require(value['status']=='PASS' and value['cleanup_verified'] is True,'Unqualified controller: '+name)
    controller_folder=root/'reference/numerical_programs_acceptance/recorded_trials/v0.4.12/controllers'
    controller_digests={sha(raw(controller_folder/(n+'.snapshot'))) for n in
        ('run_v412_linux.py','run_v412_linux_buildtracking.py','run_v412_linux_before_source_arg.py')}
    require(value['controller_sha256'] in controller_digests,'Controller bytes differ')
    kind={'tracking-3':'tracking','recovery-2':'recovery'}.get(name,name)
    require(value['kind']==kind,'Wrong container profile')
    commands={
        'sdk-core':['python','-I','/input/bootstrap.py'],
        'tracking-3':['/opt/tracking/bin/python','-I','/input/tracking-bootstrap.py'],
        'recovery-2':['/opt/tracking/bin/python','/input/recovery-bootstrap.py'],
        'build-tracking':['/opt/tracking/bin/python','-I','-c',
            "import subprocess; subprocess.run(['/opt/tracking/bin/python','-I','-m','pip','install',"
            "'--no-index','/input/eidos-0.4.12-py3-none-any.whl'],check=True); "
            "subprocess.run(['/opt/tracking/bin/python','-I','-m','pip','check'],check=True)"]}
    require(value['command']==commands[name],'Container command differs')
    input_folder=cache/{'sdk-core':'input-sdk','tracking-3':'input-tracking',
                        'recovery-2':'input-recovery','build-tracking':'input'}[name]
    actual={p.relative_to(input_folder).as_posix():sha(raw(p)) for p in input_folder.rglob('*')
            if p.is_file() and '__pycache__' not in p.parts}
    require(actual==value['input_sha256'],'Container input inventory differs')
    if name in {'sdk-core','build-tracking'}:
        require(actual.get(wheel.name)==wheel_sha,'Container wheel input differs')
    if name=='sdk-core':
        for case,checker in [('sdk','sdk_process'),('quarto','quarto_delivery'),('reproduction','reproduction'),('numerical','numerical_programs')]:
            require(actual.get(case+'-check.py')==sha(raw(root/'reference'/(checker+'_acceptance')/'check.py')),
                    'Installed lifecycle checker differs')
    paths={'/input':(input_folder.resolve(),False),'/out':(folder.resolve(),True)}
    if name in {'tracking-3','recovery-2'}:
        source_name='source-tracking' if name=='tracking-3' else 'source'
        source_folder=cache/source_name
        source_map=read(cache/(source_name+'-snapshot.json'))['files_sha256_raw']
        require(set(source_map)=={p.relative_to(source_folder).as_posix() for p in source_folder.rglob('*')
            if p.is_file() and '__pycache__' not in p.parts},'Source snapshot inventory differs')
        for member,digest in source_map.items():
            source=(source_folder/member).resolve()
            require(source.is_relative_to(source_folder.resolve()) and sha(raw(source))==digest,'Source snapshot bytes differ')
            if member!='AGENTS.md':
                expected=raw(root/member)
                observed=raw(source)
                require((observed==expected if source.suffix=='.whl' else canonical(observed)==canonical(expected)),
                        'Execution snapshot differs from current runtime/protocol')
        paths['/source']=(source_folder.resolve(),False)
    for phase in ('before','after'):
        state=value[phase]
        require(state['network']=='none' and state['Image']==value['image_id'],'Image/network differs')
        require(state['readonly_rootfs'] is (name!='build-tracking'),'Wrong root filesystem policy')
        require(state['command']==commands[name] and state['Id']==value['before']['Id'],'Container identity differs')
        mounts=state['Mounts']
        require(len(mounts)==len(paths) and {r['Destination'] for r in mounts}==set(paths),'Container mounts differ')
        for mount in mounts:
            path,writable=paths[mount['Destination']]
            require(mount['Type']=='bind' and mount['RW'] is writable and Path(mount['Source']).resolve()==path,
                    'Wrong mount source/permission')
        require(set(state['tmpfs'])=={'/tmp','/root/.cache'} and state['cap_drop']==['ALL']
                and state['security_opt']==['no-new-privileges'],'Container policy differs')
    terminal=value['after']['State']
    require(type(terminal['ExitCode']) is int and terminal['ExitCode']==0 and terminal['Status']=='exited'
            and terminal['Running'] is False and terminal['OOMKilled'] is False and terminal['Dead'] is False,
            'Worker terminal state differs')
    return value

sdk_execution=execution('sdk-core')
tracking_execution=execution('tracking-3')
recovery_execution=execution('recovery-2')
build_execution=execution('build-tracking')
require(tracking_execution['image_id']==recovery_execution['image_id']==build_execution['candidate_image_id'],
        'Tracking image differs from owned build')
public_execution=read(cache/'linux-core-1/container.json')
require(public_execution['status']=='PASS' and public_execution['cleanup_verified'] is True,'Public replay failed')
settings=public_execution['observed_settings']
require(settings['network']=='none' and settings['readonly_rootfs'] is True
        and settings['cap_drop']==['ALL'] and settings['security_opt']==['no-new-privileges'],
        'Public replay isolation differs')
public_inputs=read(cache/'input-linux/manifest.json')
require(public_execution['manifest_sha256']==sha(raw(cache/'input-linux/manifest.json'))
        and public_execution['wheelhouse_sha256']==public_inputs['wheels'],'Public replay input manifest differs')
for member,digest in public_inputs['files'].items():
    require(sha(raw(cache/'input-linux'/member))==digest,'Public input bytes differ')
require(public_inputs['files'].get(wheel.name)==wheel_sha,'Public wheel differs')
expected_mounts={'/input':((cache/'input-linux').resolve(),False),
                 '/out':((cache/'linux-core-1').resolve(),True),
                 '/wheels':(Path('C:/Users/Administrator/.cache/eidos-sdk-v411/linux-wheels').resolve(),False)}
require(len(settings['mounts'])==len(expected_mounts)
        and {m['Destination'] for m in settings['mounts']}==set(expected_mounts),'Public mount inventory differs')
for mount in settings['mounts']:
    path,writable=expected_mounts[mount['Destination']]
    require(mount['Type']=='bind' and mount['RW'] is writable and Path(mount['Source']).resolve()==path,
            'Public replay mount differs')
for member,digest in public_inputs['wheels'].items():
    require(sha(raw(expected_mounts['/wheels'][0]/member))==digest,'Public dependency wheel differs')
terminal=public_execution['terminal_state']
require(type(terminal['ExitCode']) is int and terminal['ExitCode']==0 and terminal['Status']=='exited'
        and terminal['Running'] is False and terminal['OOMKilled'] is False and terminal['Dead'] is False,
        'Public replay terminal differs')

for case,name,old in [('sdk','SDK-PROCESS-ACCEPTANCE.json','sdk-process'),
                     ('quarto','QUARTO-DELIVERY-ACCEPTANCE.json','quarto-delivery'),
                     ('reproduction','REPRODUCTION-ACCEPTANCE.json','reproduction')]:
    archived=old+'-acceptance-v0.4.11.json'
    record=read(docs/'archive'/archived)
    lineage=record.get('lineage')
    record['lineage']={'previous_release':'v0.4.11','previous_record':'archive/'+archived,
                       'previous_wheel_sha256':record['wheel_sha256'],'earlier':lineage}
    record['historical_fields']=[key for key in ('initial_red','focused_regression','fixtures','broken_controls') if key in record]
    record.update(generated=now,wheel=wheel.relative_to(root).as_posix(),wheel_sha256=wheel_sha)
    require(sha(raw(root/record['driver']))==record['driver_sha256'],'Historical lifecycle driver changed')
    if case=='sdk':record['source_sha256_canonical_lf']=modules
    else:record['source_inventory']='SDK-PROCESS-ACCEPTANCE.json#source_sha256_canonical_lf'
    record['docker_image']=sdk_execution['image_id'] if case=='sdk' else record.get('docker_image')
    if record.get('docker_image') is None:record.pop('docker_image',None)
    record['optimization_controls']={}
    for platform,folder in [('windows',cache/'windows-delivery'),('linux',cache/'sdk-core/results')]:
        result=read(folder/(case+'.json'))
        guards.lifecycle(result,case,platform)
        require(result['sdk_version']=='0.4.12' and result['source_sha256_canonical_lf']==modules,'Wrong installed source')
        record[platform]={'status':'PASS','result':result,
            'installation':'Fresh non-editable venv; complete hash-locked normal core dependencies, normal wheel install and pip check.'}
        if platform=='linux':record[platform].update(image=sdk_execution['image_id'],network='none',
            execution='NUMERICAL-PROGRAMS-ACCEPTANCE.json#additional_sdk_linux_execution')
        controls=read(folder/'optimization.json')[case]
        guards.optimization(controls)
        record['optimization_controls'][platform]=controls
    put(name,record)

live=read(docs/'archive/recovery-live-acceptance-v0.4.11.json')
live.update(generated=now,version='0.4.12',docker_image=recovery_execution['image_id'],
    method='Original c12acdd paired failures retained; unchanged checker replayed against candidate source with disposable real HTTP services.',
    previous_record='archive/recovery-live-acceptance-v0.4.11.json')
for platform,folder,file in [('windows',cache,'windows-recovery.json'),('linux',cache/'recovery-2','recovery.json')]:
    value=read(folder/file)
    guards.recovery(value,platform)
    require(set(value['source_sha256_lf'])=={'framework/recovery.py','framework/services.py','tools/watch_pipeline.py','framework/artifacts.py','framework/subprocesses.py','framework/_process_tree.py','framework/_windows_job.py','framework/_posix_job.py','tools/owned_workspace.py','pyproject.toml','uv.lock','reference/recovery_acceptance/check.py','reference/recovery_acceptance/service.py'},'Recovery source inventory differs')
    for name,expected in value['source_sha256_lf'].items():
        require(sha(canonical(raw(root/name)))==expected,'Recovery source drift')
    controls=read(folder/('windows-recovery-controls' if platform=='windows' else 'recovery-controls')/'summary.json')
    guards.negative(controls,'recovery')
    control_folder=folder/('windows-recovery-controls' if platform=='windows' else 'recovery-controls')
    for row in controls:
        path=control_folder/(row['case']+'.json')
        original=read(path)
        if row['case'] in {'-O','-OO'}:
            require(raw(path)==raw(folder/file),'Recovery optimized mode altered the positive receipt')
        else:
            require(sha(raw(path))==row['receipt_sha256'] and original['status']=='FAIL'
                    and original['platform']==value['platform'] and original['source_sha256_lf']==value['source_sha256_lf'],
                    'Recovery negative evidence differs')
    live['after'][platform]=value
    live['negative_controls'][platform]=controls
live['linux_execution']=recovery_execution
put('RECOVERY-LIVE-ACCEPTANCE.json',live)

core=read(docs/'archive/core-recovery-acceptance-v0.4.11.json')
core.update(recorded_at=now,version='0.4.12',tests_passed=audit['tests']['passed'],
            historical_record='docs/archive/core-recovery-acceptance-v0.4.11.json')
core['source_sha256_lf']={n:sha(canonical(raw(root/n))) for n in set(core['source_sha256_lf'])|{'tests/test_recovery_shell.py','.github/workflows/installed-sdk.yml','reference/recovery_shell_acceptance/check.py','reference/recovery_shell_acceptance/bootstrap.py'}}
core.pop('publication_metadata_recheck',None)
core['historical_read_only_reviews']=core.pop('read_only_reviews',[])
core['publication_review']={'status':'PENDING','scope':'0.4.12 current assembler and final publication; historical approvals are not new approvals.'}
core['full_self_audit']={'tests_collected':audit['tests_collected'],'tests':audit['tests'],
    'coverage_total':audit['coverage_total'],'chains':audit['chains'],'source_stable':True,
    'receipt_sha256':sha(raw(docs/'SELF_AUDIT.json'))}
core['paired_live_record']['sha256']=sha(pending['RECOVERY-LIVE-ACCEPTANCE.json'])
core['installed_shell_checkpoint']={'path':'docs/RELEASE-CANDIDATE-0.4.12.json',
    'sha256':sha(raw(docs/'RELEASE-CANDIDATE-0.4.12.json')),
    'scope':'Four finite installed shell controls on each platform, separate from source disposable-service recovery.'}
put('CORE-RECOVERY-ACCEPTANCE.json',core)

tracking=read(docs/'archive/tracking-acceptance-v0.4.11.json')
tracking['historical_read_only_reviews']=tracking.pop('read_only_reviews',[])
tracking['historical_fields']=['before','ordinary_overlay_attempt','harness_control_suite']
tracking.update(generated=now,version='0.4.12',wheel=wheel.relative_to(root).as_posix(),wheel_sha256=wheel_sha,
    previous_record='archive/tracking-acceptance-v0.4.11.json',
    release_qualification='Installed candidate qualification; exact-final-commit CI and release assets are separate.')
driver=sha(canonical(raw(root/tracking['driver'])))
require(driver==tracking['driver_sha256_lf'],'Tracking protocol changed')
baseline_tracking_cases={(r['class'],r['case']) for r in tracking['windows']['cases']}
for platform,path,expected in [('windows',cache/'windows-tracking.json','win32'),
                              ('linux',cache/'tracking-3/tracking.json','linux')]:
    value=read(path)
    require(value['status']=='PASS' and value['sdk_version']=='0.4.12' and value['platform']==expected
            and value['optimization_level']==0 and value['source_sha256_canonical_lf']==modules
            and value['wheel_sha256']==wheel_sha and value['driver_sha256_lf']==driver,'Tracking identity differs')
    require(len(value['cases'])==49 and len({(r['class'],r['case']) for r in value['cases']})==49
            and all(r['accepted'] is True for r in value['cases']),'Tracking controls differ')
    require({(r['class'],r['case']) for r in value['cases']}
            ==baseline_tracking_cases,'Tracking case inventory differs')
    require(set(value['protocol_sha256_lf'])=={'test_tracking_contract.py','test_tracking_dvc.py','test_tracking_protocol.py'},
            'Tracking source inventory differs')
    for n,expected_sha in value['protocol_sha256_lf'].items():
        require(sha(canonical(raw(root/'tests'/n)))==expected_sha,'Tracking test protocol differs')
    tracking[platform]=value
require(tracking['windows']['cases']==tracking['linux']['cases'],'Tracking platform protocols differ')
controls=read(cache/'controls-final/summary.json')
guards.negative(controls,'tracking')
for row in controls:
    path=cache/'controls-final'/('wrong-metadata.json' if row['case']=='same-code-wrong-metadata' else row['case']+'.json')
    original=read(path)
    require(sha(raw(path))==row['receipt_sha256'] and original['platform']=='win32','Tracking negative receipt differs')
    if row['case'] in {'-O','-OO'}:
        require(raw(path)==raw(cache/'windows-tracking.json'),'Tracking optimized mode altered the positive receipt')
    else:
        message='METADATA identity differs' if row['case']=='same-code-wrong-metadata' else 'Protocol process failed'
        require(original['status']=='FAIL' and message in original['error'],'Tracking rejection has the wrong cause')
tracking['windows_negative_controls']=controls
tracking['linux_execution']={'network':'none','image':tracking_execution['image_id'],
    'workspace':'Private tmpfs only; no disk performance or persistence claim.',
    'exit_code':0,'command':tracking_execution['command'],'tmpfs':tracking_execution['after']['tmpfs'],
    'receipt_sha256':sha(raw(cache/'tracking-3/tracking.json')),'controller':tracking_execution}
tracking['full_source_audit']={'path':'docs/SELF_AUDIT.json','sha256':sha(raw(docs/'SELF_AUDIT.json')),
    'tests':audit['tests'],'coverage_total':audit['coverage_total'],'stable':True}
tracking['ordinary_overlay_attempt']['scope']='Retained v0.4.10 failure; no new v0.4.12 ordinary-overlay PASS is claimed.'
put('TRACKING-ACCEPTANCE.json',tracking)

api_driver='reference/numerical_programs_acceptance/check.py'
api_sha=sha(canonical(raw(root/api_driver)))
api_results={}
for platform,folder,file in [('windows',cache/'windows-results','numerical.json'),('linux',cache/'linux-core-1','numerical.stdout')]:
    value=read(folder/file)
    new_guards.numerical(value,platform,modules,wheel_sha,api_sha)
    api_results[platform]=value
negative=read(cache/'installed-negatives-v2/summary.json')
new_guards.installed_negatives(negative)
archive=root/'reference/numerical_programs_acceptance/recorded_trials/v0.4.12'
manifest=read(archive/'manifest.json')
declared=manifest['files']
require({p.relative_to(archive).as_posix() for p in archive.rglob('*') if p.is_file()}==set(declared)|{'manifest.json'},
        'Archive inventory differs')
for name,item in declared.items():
    body=raw(archive/name)
    require(sha(body)==item['sha256'] and len(body)==item['size'],'Archive member changed')
    if name.startswith('trials/'):
        cache_name=name.removeprefix('trials/')
        if cache_name.endswith('.py.snapshot'):cache_name=cache_name.removesuffix('.snapshot')
        require(raw(cache/cache_name)==body,'Archive differs from assembled raw trial input')
for folder in ('tracking','tracking-2','recovery'):
    require(read(archive/'trials'/folder/'execution.json')['status']=='FAIL','Failed controller was hidden')
put('NUMERICAL-PROGRAMS-ACCEPTANCE.json',{
    'schema':1,'kind':'eidos.numerical-programs-sdk-qualification','generated':now,'status':'PASS','version':'0.4.12',
    'wheel':wheel.relative_to(root).as_posix(),'wheel_sha256':wheel_sha,'driver':api_driver,'driver_sha256_lf':api_sha,
    'source_sha256_canonical_lf':modules,**api_results,'windows_negative_controls':negative,
    'linux_execution':public_execution,'additional_sdk_linux_execution':sdk_execution,
    'tracking_image_build':build_execution,'bootstrap':public_inputs,
    'full_source_audit_sha256':sha(raw(docs/'SELF_AUDIT.json')),
    'archive':'reference/numerical_programs_acceptance/recorded_trials/v0.4.12',
    'archive_manifest_sha256':sha(raw(archive/'manifest.json')),
    'assembly_sources_sha256':assembly_hashes,
    'free_reuse':{'gemini_api':False,'paid_service':False,'mandatory_credentials':False,'execution':'local CPU'},
    'limits':['Known external numerical methods and explicitly supplied derivatives; no model or RSI qualification.',
              'Same-host Windows and offline Linux, not new hardware, GPU, vectors, AD or a whole-domain guarantee.',
              'Public dependency bootstrap is separate; Linux qualifier networking was disabled.',
              'Docker E: bind failures and the incomplete tracking source snapshot remain retained FAIL records.',
              'Dependency METADATA/RECORD stability is not a hostile-process or full dependency-file integrity sandbox.']})
require(input_state()==audit['stability']['before']==audit['stability']['after'],'Source/environment changed during assembly')
for path,body in inputs.items():require(path.read_bytes()==body,'Assembly input changed before publication')
for path,body in list(inputs.items()):
    if path.is_relative_to(cache.resolve()):
        member='trials/'+path.relative_to(cache.resolve()).as_posix()
        if path.suffix=='.py':member+='.snapshot'
        item=manifest['files'].get(member) or manifest['external_artifacts'].get(member)
        if item is not None:require(sha(body)==item['sha256'] and len(body)==item['size'],'Consumed trial differs from archive')
if '--check' in sys.argv:
    print('Verified',len(pending),'candidate aliases; dry run, no current records changed.')
else:
    originals={name:(docs/name).read_bytes() for name in pending}
    published=[]
    try:
        for name,body in pending.items():
            with atomic_output(docs/name) as temporary:temporary.write_bytes(body)
            published.append(name)
    except BaseException:
        for name in reversed(published):
            with atomic_output(docs/name) as temporary:temporary.write_bytes(originals[name])
        raise
    print('Assembled actual v0.4.12 installed/recovery/source receipts with exact current audit and wheel bindings.')
